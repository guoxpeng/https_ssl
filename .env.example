# 复制为 .env 后修改（不改也能跑，全部有默认值）。.env 不得提交到版本库。

# admin 初始密码，默认 admin。只在首次启动、还没有 users.json 时生效。
QILIN_ADMIN_PASSWORD=admin

# 会话签名密钥。留空时每次启动随机生成，容器重启会导致所有登录会话失效。
# 生成方式：openssl rand -hex 32
QILIN_SECRET_KEY=

# 面板经 HTTPS 反代暴露时置 1
QILIN_COOKIE_SECURE=0

# 用户表位置。默认在容器内 /app/users.json，重建容器会丢密码；
# 仓库自带的 compose 文件指向挂载出来的 /app/data/users.json。
# QILIN_USERS_FILE=/app/data/users.json

# 时区（镜像里已默认 Asia/Shanghai）
# TZ=Asia/Shanghai

# 想换镜像（比如用国内加速站），改这里
# QILIN_IMAGE=nameguoguo/https_ssl:latest
